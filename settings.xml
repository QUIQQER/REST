<?xml version="1.0" encoding="UTF-8"?>
<quiqqer xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://www.quiqqer.com/docs/schemas/2.x/settings.xsd">
    <settings>

        <config>
            <section name="general">
                <conf name="baseHost">
                    <type><![CDATA[string]]></type>
                    <defaultvalue/>
                </conf>
                <conf name="basePath">
                    <type><![CDATA[string]]></type>
                    <defaultvalue>/api/</defaultvalue>
                </conf>
            </section>
            <section name="openapi">
                <conf name="selection">
                    <type><![CDATA[string]]></type>
                    <defaultvalue/>
                </conf>
            </section>
        </config>

        <window name="quiqqer-rest">
            <title>REST (Representational State Transfer)</title>
            <params>
                <icon>fa fa-server</icon>
            </params>

            <categories>
                <category name="cron_settings" index="1">
                    <text>REST (Representational State Transfer)</text>
                    <icon>fa fa-braille</icon>

                    <settings title="settings" name="settings">
                        <title>
                            <locale group="quiqqer/rest" var="settings.cron.title"/>
                        </title>
                        <input conf="general.baseHost">
                            <text>
                                <locale group="quiqqer/rest" var="settings.baseHost"/>
                            </text>
                        </input>
                        <input conf="general.basePath">
                            <text>
                                <locale group="quiqqer/rest" var="settings.basePath"/>
                            </text>
                        </input>
                    </settings>
                </category>

                <category name="openapi" index="2">
                    <text>OpenAPI</text>
                    <icon>fa fa-code</icon>
                    <settings name="openapi">
                        <title>/openapi.json</title>
                        <description>
                            <locale group="quiqqer/rest" var="settings.openapi.description"/>
                        </description>
                        <input conf="openapi.selection" type="hidden" label="false"
                               data-qui="package/quiqqer/rest/bin/settings/OpenApiPublication"/>
                    </settings>
                </category>
            </categories>
        </window>

    </settings>
</quiqqer>
